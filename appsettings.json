{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ExternalApi": {
    "Url": "https://example.invalid/api/upload",
    "Credential": "replace-with-client-identifier",
    "Secret": "replace-with-shared-secret",
    "SecretEncoding": "Base64", // Can be Hex or Base64.

    "TimestampHeader": "X-Timestamp", // Unix timestamp.
    "ContentDigestHeader": "x-ms-content-sha256" // Plain base64 hash.
  },
  "AllowedHosts": "*"
}
